# Datafordeler apiKey — authenticates Fildownload + GraphQL.
# Create at https://selfservice.datafordeler.dk (web user + service user / API key).
DATAFORDELER_API_KEY=your_datafordeler_api_key_here

# GSSearch token (optional, autocomplete cross-check). From dataforsyningen.dk.
GSEARCH_TOKEN=your_gsearch_token_here

# Postgres+PostGIS DSN (matches docker-compose.yml).
DATABASE_URL=postgres://notdawa:notdawa@localhost:5432/notdawa?sslmode=disable
