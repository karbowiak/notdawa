      }
    ]
  },
  "brofasthed": {
    "key": [
      "stedid"
    ],
    "attributes": [
      {
        "name": "stedid",
        "type": "uuid",
        "nullable": false,
        "description": "Øens unikke ID (UUID)"
      },
      {
        "name": "brofast",
        "type": "boolean",
        "nullable": false,
        "description": "Angiver, om øen er brofast."
      }
    ]
  },
  "bygning": {
    "key": [
      "id"
    ],
    "attributes": [
      {
        "name": "id",
        "type": "string",
        "nullable": false,
        "description": "Bygningspolygonets unikke ID. Heltal."
      },
      {
        "name": "bygningstype",
        "type": "string",
        "nullable": false,
        "description": "Angiver bygningens type, eksempelvis \"Bygning\", \"Drivhus\", \"Tank/Silo\"."
      },
      {
        "name": "metode3d",
        "type": "string",
        "nullable": false,
        "description": "Angiver hvor Z-koordinaten er registreret. Fotogrammetrisk anvendes altid \"Tag\". \n        Dog kan \"3D-Tag\" anvendes, hvis det eksplicit er aftalt i forbindelse med 3D-bygningsmodellering.\n        Anvendelse af ”Under terræn” muliggør registrering af en underjordisk bygning.\n        Mulige værdier: 3D-Tag, Tag, Terræn, Under terræn, Ikke tildelt, Ukendt."
      },
      {
        "name": "målested",
        "type": "string",
        "nullable": false,
        "description": "Angiver målestedet for bygningspolygonet. Mulige værdier: \"Tag\", \"Væg\", \"Tag og Væg\", \"Ukendt\", \"Ikke Tildelt\"."
      },
      {
        "name": "bbrbygning_id",
        "type": "uuid",
        "nullable": true,
        "description": "Angiver bygningens ID i Bygnings- og Boligregisteret (BBR). UUID."
      },
      {
        "name": "synlig",
        "type": "boolean",
        "nullable": false,
        "description": "Angiver, om en Bygning er synlig i et ortofoto. At den ikke er synlig skyldes, \n        at et andet GeoDanmark objekt skjuler den helt eller delvist eller at den ligger helt eller \n        delvist under jorden.\n        \"false\"= Bygning er helt eller delvist usynlig i et ortofoto.\n        \"true\"= Bygning er synlig i et ortofoto.\n"
      },
      {
        "name": "overlap",
        "type": "boolean",
        "nullable": false,
        "description": "Angiver, om en Bygning overlappes helt eller delvist af en anden Bygning.\n        \"false\"= Bygning er ikke helt eller delvist overlappet af en anden Bygning.\n        \"true\"= Bygning er helt eller delvist overlappet af en anden Bygning.\n"
      },
      {
        "name": "geometri",
        "type": "geometry3d",
        "nullable": false,
        "description": "Bygningens geometri. Leveres som GeoJSON polygon."
      }
    ]
  },
  "bygningtilknytning": {
