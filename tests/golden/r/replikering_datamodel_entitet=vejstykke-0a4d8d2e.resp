  "ejerlav": {
    "key": [
      "kode"
    ],
    "attributes": [
      {
        "name": "kode",
        "type": "integer",
        "nullable": false,
        "description": "Unik identifikation af det matrikulære ”ejerlav”. Repræsenteret ved indtil 7 cifre. Eksempel: ”170354” for ejerlavet ”Eskebjerg By, Bregninge”."
      },
      {
        "name": "navn",
        "type": "string",
        "nullable": false,
        "description": "Det matrikulære ”ejerlav”s navn. Eksempel: ”Eskebjerg By, Bregninge”."
      },
      {
        "name": "geo_version",
        "type": "integer",
        "nullable": false,
        "description": "Versionsangivelse for geometrien. Inkrementeres hver gang geometrien ændrer sig i DAWA."
      },
      {
        "name": "geo_ændret",
        "type": "timestamp",
        "nullable": false,
        "description": "Tidspunkt for seneste ændring af geometrien registreret i DAWA."
      },
      {
        "name": "ændret",
        "type": "timestamp",
        "nullable": false,
        "description": "Tidspunkt for seneste ændring registreret i DAWA. Opdateres ikke hvis ændringen kun vedrører geometrien (se felterne geo_ændret og geo_version)."
      },
      {
        "name": "visueltcenter",
        "type": "geometry",
        "nullable": true,
        "description": "Ejerlavets visuelle center. Kan f.eks. bruges til at placere en label for ejerlavet på at kort."
      },
      {
        "name": "bbox",
        "type": "geometry",
        "nullable": true,
        "description": "Ejerlavets bounding box, dvs. det mindste rectangel som indeholder geometrien. \n        Består af et array af 4 tal.\n        De første to tal er koordinaterne for bounding boxens sydvestlige hjørne, og to sidste tal er\n        koordinaterne for bounding boxens nordøstlige hjørne."
      },
      {
        "name": "geometri",
        "type": "geometry",
        "nullable": true,
        "description": "Ejerlavets geometri.",
        "offloaded": true
      }
    ]
  },
  "højde": {
    "key": [
      "husnummerid"
    ],
    "attributes": [
      {
        "name": "husnummerid",
        "type": "uuid",
        "nullable": false,
        "description": "Husnummeret (adgangsadressen), hvis adgangspunkt som rækken angiver højden på"
      },
      {
        "name": "højde",
        "type": "real",
        "nullable": false,
        "description": "Adgangspunktets højde i meter over havoverfladen. Beregnet ud fra Danmarks Højdemodel. Værdien -9999 angiver, at højden er udenfor højdemodellen, og derfor ikke kan beregnes."
      }
    ]
  },
  "ikke_brofast_husnummer": {
    "key": [
      "husnummerid"
    ],
    "attributes": [
      {
        "name": "husnummerid",
        "type": "uuid",
        "nullable": false,
        "description": "Det ikke brofaste husnummers UUID"
      }
    ]
  },
  "jordstykke": {
    "key": [
      "ejerlavkode",
      "matrikelnr"
    ],
    "attributes": [
      {
        "name": "ejerlavkode",
        "type": "integer",
        "nullable": false,
        "description": "Unik identifikation af det matrikulære ”ejerlav”. Repræsenteret ved indtil 7 cifre. Eksempel: ”170354” for ejerlavet ”Eskebjerg By, Bregninge”."
      },
      {
        "name": "matrikelnr",
        "type": "string",
        "nullable": false,
        "description": "Unik identifikation af jordstykket indenfor ejerlavet. Består af bogstaver og tal."
      },
      {
        "name": "kommunekode",
        "type": "string",
        "nullable": false,
        "description": "Kommunekoden. 4 cifre."
      },
      {
        "name": "regionskode",
        "type": "string",
        "nullable": false,
        "description": "Regionskoden. 4 cifre."
      },
      {
        "name": "sognekode",
        "type": "string",
        "nullable": false,
        "description": "Sognekoden. 4 cifre."
      },
      {
        "name": "retskredskode",
        "type": "string",
        "nullable": false,
        "description": "Retskredskoden. 4 cifre."
      },
      {
        "name": "esrejendomsnr",
        "type": "string",
        "nullable": true,
        "description": "⚠ Bemærk: DAWA anvender tilbagekonverteret BBR-data, som ikke længere opdateres fra 16. december 2023. BBR-data udfases helt i DAWA pr. 1. april 2024. Læs mere på https://dataforsyningen.dk/news/4915. Identifikation af den vurderingsejendom jf. Ejendomsstamregisteret, ESR, som jordstykket er en del af. Repræsenteret ved 7 cifre. Eksempel ”0035512”."
      },
      {
        "name": "udvidet_esrejendomsnr",
        "type": "string",
        "nullable": true,
        "description": "⚠ Bemærk: DAWA anvender tilbagekonverteret BBR-data, som ikke længere opdateres fra 16. december 2023. BBR-data udfases helt i DAWA pr. 1. april 2024. Læs mere på https://dataforsyningen.dk/news/4915. Identifikation af den vurderingsejendom jf. Ejendomsstamregisteret, ESR, som jordstykket er en del af. Repræsenteret ved 10 cifre, hvor de første 3 cifre er kommunekoden hvor ejerskabet er placeret. Eksempel ”6070035512”."
      },
      {
        "name": "sfeejendomsnr",
        "type": "string",
        "nullable": true,
        "description": "SFE ejendomsnummer."
      },
      {
        "name": "bfenummer",
        "type": "integer",
        "nullable": true,
        "description": "BFE Nummer."
      },
      {
        "name": "geometri",
        "type": "geometry",
        "nullable": false,
        "description": "Jordstykkets geometri. Leveres som GeoJSON polygon."
      },
      {
        "name": "featureid",
        "type": "string",
        "nullable": false,
        "description": "Jordstykkets featureid, en unik identifikator som anvendes i matrikelkortet."
      },
      {
        "name": "fælleslod",
        "type": "boolean",
        "nullable": false,
        "description": "angivelse om jordstykket indgår i flere faste ejendomme."
      },
      {
        "name": "moderjordstykke",
        "type": "integer",
        "nullable": true,
        "description": "featureid for det jordstykke som jordstykket er udstykket fra."
      },
      {
        "name": "registreretareal",
        "type": "integer",
        "nullable": false,
        "description": "det i matriklen registrerede sande areal på jordstykket – ikke nødvendigvis identisk med det geometriske areal - angivet som heltal i kvadratmeter"
      },
      {
        "name": "arealberegningsmetode",
        "type": "string",
        "nullable": false,
        "description": "angivelse af beregningsmåden for det registrerede areal for jordstykket – følgende koder benyttes:\n        <ul>\n        <li>o – arealet er beregnet efter opmåling</li>\n        <li>s – arealet er beregnet efter konstruktion i større målforhold, dvs. større end det analoge matrikelkort</li>\n        <li>k – arealet er beregnet på grundlag af kort</li></ul>"
      },
      {
        "name": "vejareal",
        "type": "integer",
        "nullable": false,
        "description": "det i matriklen registrerede sande areal af vejudlæg på jordstykket angivet som heltal i kvadratmeter"
      },
      {
        "name": "vejarealberegningsmetode",
        "type": "string",
        "nullable": false,
        "description": "angivelse af beregningsmåden for det registrerede areal af vej på jordstykket – følgende koder benyttes:\n        <ul>\n        <li>b – vejareal på jordstykket er beregnet (og kan være 0)</li>\n        <li>e – der er konstateret vej på jordstykket, men areal er ikke beregnet</li>\n        <li>u – det er ukendt, om der findes vej på jordstykket</li>\n        </ul>"
      },
      {
        "name": "vandarealberegningsmetode",
        "type": "string",
        "nullable": false,
        "description": "\n        angivelse af beregningsmåden for det registrerede areal af vand på jordstykket – følgende koder benyttes:\n        <ul>\n        <li> incl – vandareal på jordstykket et inkluderet i det registrerede areal for jordstykket</li>\n        <li> excl – vandareal på jordstykket er ikke inkluderet i det registrerede areal for jordstykket</li>\n        <li>ukendt – vandareal er ikke oplyst</li> \n        </ul>"
      },
      {
        "name": "visueltcenter",
        "type": "geometry",
        "nullable": false,
        "description": "Jordstykkets visuelle center."
      },
      {
        "name": "bbox",
        "type": "geometry",
        "nullable": true,
        "description": "Bounding box for jordstykkets geometri."
      }
    ]
  },
